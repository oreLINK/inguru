{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SilverEvent",
  "description": "Événement normalisé : dates parsées, lieu géocodé, ID déterministe",
  "type": "object",
  "required": ["id", "date", "title", "locationSlug", "lat", "lng"],
  "properties": {
    "id": {
      "type": "string",
      "description": "ID déterministe: YYYY-MM-DD-slug-du-titre"
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "startTime": {
      "type": ["string", "null"],
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "endTime": {
      "type": ["string", "null"],
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "note": { "type": ["string", "null"] },
    "priceRaw": { "type": ["string", "null"] },
    "locationRaw": { "type": "string" },
    "locationSlug": { "type": "string" },
    "lat": { "type": "number" },
    "lng": { "type": "number" },
    "address": { "type": ["string", "null"] },
    "sourceUrl": { "type": "string" },
    "scrapedAt": { "type": "string" }
  }
}
