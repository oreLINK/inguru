{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BronzeEvent",
  "description": "Événement brut extrait du scraping HTML",
  "type": "object",
  "required": ["_day", "title_raw"],
  "properties": {
    "_day": { "type": "string", "description": "Libellé du jour (ex: 'Jeudi 23 Avril 2026')" },
    "_sourceUrl": { "type": "string" },
    "_scrapedAt": { "type": "string" },
    "_index": { "type": "integer" },
    "time_raw": { "type": ["string", "null"] },
    "location_raw": { "type": ["string", "null"] },
    "title_raw": { "type": "string", "minLength": 1 },
    "note": { "type": ["string", "null"] },
    "price_raw": { "type": ["string", "null"] }
  }
}
