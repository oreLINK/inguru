{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoldEvent",
  "description": "Événement enrichi : catégorisé, traduit, format final app",
  "type": "object",
  "required": ["id", "title", "date", "location", "category", "festivalId", "cityId"],
  "properties": {
    "id": { "type": "string" },
    "title": {
      "type": "object",
      "required": ["fr"],
      "properties": {
        "fr": { "type": "string" },
        "es": { "type": ["string", "null"] },
        "eu": { "type": ["string", "null"] }
      }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "startTime": { "type": ["string", "null"] },
    "endTime": { "type": ["string", "null"] },
    "location": {
      "type": "object",
      "required": ["lat", "lng"],
      "properties": {
        "name": {
          "type": "object",
          "properties": {
            "fr": { "type": ["string", "null"] },
            "es": { "type": ["string", "null"] },
            "eu": { "type": ["string", "null"] }
          }
        },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "address": { "type": ["string", "null"] }
      }
    },
    "description": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "fr": { "type": ["string", "null"] },
            "es": { "type": ["string", "null"] },
            "eu": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "category": { "type": "string" },
    "image": { "type": ["string", "null"] },
    "festivalId": { "type": "string" },
    "cityId": { "type": "string" }
  }
}
